# Copy this file to .env. Never commit a real API key.
RIVET_PROTOCOL=openai_chat
RIVET_BASE_URL=https://api.openai.com/v1
RIVET_ENDPOINT_PATH=/chat/completions
RIVET_MODEL=
RIVET_API_KEY=
RIVET_AUTH_STYLE=bearer

# Optional provider-specific request values and service headers.
RIVET_EXTRA_BODY_JSON={}
RIVET_EXTRA_HEADERS_JSON={}

# Assistant response fields that must be replayed in later requests.
RIVET_REPLAY_FIELDS_JSON=["reasoning_content"]

# Optional read-only sub-agent limits.
RIVET_SUBAGENT_MAX_STEPS=12
RIVET_MAX_SUBAGENTS_PER_TURN=2
RIVET_SUBAGENT_PARALLELISM=2
